# Frontend environment variables.
# Never commit secrets to source.

# --- External Backend API (contracts/chat-api.md, D15, FR-032) -----------------
# Base URL for the external FastAPI backend. Defaults to http://127.0.0.1:8000 if unset.
NEXT_PUBLIC_BACKEND_URL=http://127.0.0.1:8000

# Server-side secret for triggering graph rebuilds (specs/001-wiki-graph-view/quickstart.md)
REBUILD_SECRET_KEY=local_dev_secret

# Original Wiki Source Github Repo
NEXT_PUBLIC_ORIGINAL_WIKI_REPO=original_repo_wiki_folder_link
